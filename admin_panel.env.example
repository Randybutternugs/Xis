# TullSite Admin Panel configuration.
# Copy to admin_panel.env and fill in. admin_panel.env is gitignored.

# Upstream TullSite admin API. No trailing slash.
TULLSITE_API_URL=https://xissite-355821.ue.r.appspot.com

# Must match ADMIN_API_KEY in TullSite's app.yaml.
# The panel refuses to start without it.
ADMIN_API_KEY=

# Bind address and port on ARCS.
# The panel has NO authentication, so it defaults to loopback (127.0.0.1).
# To expose on the LAN (ARCS only, behind a router), set ADMIN_PANEL_HOST=0.0.0.0.
# WARNING: Never port-forward 5002 or expose via Tailscale funnel.
ADMIN_PANEL_HOST=127.0.0.1
ADMIN_PANEL_PORT=5002
